library ieee;
use ieee.std_logic_1164.all;

entity top is
  port (
    clk_50 : in std_logic;
    rst : in std_logic;
    -- VGA outputs
    vga_hsync : out std_logic;
    vga_vsync : out std_logic;
    vga_r : out std_logic_vector(3 downto 0);
    vga_g : out std_logic_vector(3 downto 0);
    vga_b : out std_logic_vector(3 downto 0)
  );
end entity;

architecture struct of top is
  -- Constants for generics
  constant FB_WIDTH : integer := 200;
  constant FB_WIDTH_W : integer := 8;
  constant FB_HEIGHT : integer := 150;
  constant FB_ADDR_W : integer := 15;
  constant FB_DATA_W : integer := 4;
  constant FB_SCALE : integer := 4;
  constant FB_SCALE_W : integer := 3;

  -- Component declaration for frame_generator
  component frame_generator
    generic (
      FB_WIDTH : integer := 200;
      FB_HEIGHT : integer := 150;
      FB_ADDR_W : integer := 15;
      FB_DATA_W : integer := 4
    );
    port (
      clk : in std_logic;
      rst : in std_logic;
      data_out : out std_logic_vector(FB_DATA_W - 1 downto 0);
      addr_out : out std_logic_vector(FB_ADDR_W - 1 downto 0);
      we_out : out std_logic
    );
  end component;

  -- Component declaration for framebuffer
  component framebuffer
    generic (
      FB_WIDTH : integer := 200;
      FB_WIDTH_W : integer := 8;
      FB_HEIGHT : integer := 150;
      FB_ADDR_W : integer := 15;
      FB_DATA_W : integer := 4;
      FB_SCALE : integer := 4;
      FB_SCALE_W : integer := 3
    );
    port (
      clk_50 : in std_logic;
      rst : in std_logic;
      data_in : in std_logic_vector(FB_DATA_W - 1 downto 0);
      addr_in : in std_logic_vector(FB_ADDR_W - 1 downto 0);
      we : in std_logic;
      vga_hsync : out std_logic;
      vga_vsync : out std_logic;
      vga_r : out std_logic_vector(3 downto 0);
      vga_g : out std_logic_vector(3 downto 0);
      vga_b : out std_logic_vector(3 downto 0)
    );
  end component;

  -- Signals for connecting frame_generator to framebuffer
  signal fg_data : std_logic_vector(FB_DATA_W - 1 downto 0);
  signal fg_addr : std_logic_vector(FB_ADDR_W - 1 downto 0);
  signal fg_we : std_logic;

begin
  -- Instantiate frame_generator
  fg_inst: component frame_generator
    generic map (
      FB_WIDTH => FB_WIDTH,
      FB_HEIGHT => FB_HEIGHT,
      FB_ADDR_W => FB_ADDR_W,
      FB_DATA_W => FB_DATA_W
    )
    port map (
      clk => clk_50,
      rst => rst,
      data_out => fg_data,
      addr_out => fg_addr,
      we_out => fg_we
    );

  -- Instantiate framebuffer
  fb_inst: component framebuffer
    generic map (
      FB_WIDTH => FB_WIDTH,
      FB_WIDTH_W => FB_WIDTH_W,
      FB_HEIGHT => FB_HEIGHT,
      FB_ADDR_W => FB_ADDR_W,
      FB_DATA_W => FB_DATA_W,
      FB_SCALE => FB_SCALE,
      FB_SCALE_W => FB_SCALE_W
    )
    port map (
      clk_50 => clk_50,
      rst => rst,
      data_in => fg_data,
      addr_in => fg_addr,
      we => fg_we,
      vga_hsync => vga_hsync,
      vga_vsync => vga_vsync,
      vga_r => vga_r,
      vga_g => vga_g,
      vga_b => vga_b
    );
end architecture;