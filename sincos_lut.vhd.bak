library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

-- General-purpose sin/cos lookup table.
--
-- Input:
--   angle : unsigned index into the LUT, range 0 to LUT_DEPTH-1.
--           Represents a full 360deg circle, so:
--             0              =   0deg
--             LUT_DEPTH/4    =  90deg
--             LUT_DEPTH/2    = 180deg
--             3*LUT_DEPTH/4  = 270deg
--
-- Output (1 cycle latency):
--   sin_val : signed Q1.10, range -1023..+1023
--   cos_val : signed Q1.10, range -1023..+1023
--
-- cos is obtained for free by reading the same ROM at angle + LUT_DEPTH/4
-- (a 90deg shift), so only one M9K block is used.
--
-- To convert a real angle to a LUT index:
--   index = round(angle_deg * LUT_DEPTH / 360)  (in Python, at generation time)
--
-- Example instantiation:
--   u_sincos : entity work.sincos_lut
--       port map (
--           clk     => clk,
--           angle   => my_angle,   -- unsigned(9 downto 0) for LUT_DEPTH=1024
--           sin_val => my_sin,
--           cos_val => my_cos
--       );

entity sincos_lut is
    generic (
        LUT_DEPTH : integer := 1024;  -- must match the .mif DEPTH
        FRAC_BITS : integer := 10     -- Q1.FRAC_BITS, must match the .mif WIDTH-1
    );
    port (
        clk     : in  std_logic;
        angle   : in  unsigned(9 downto 0);              -- log2(LUT_DEPTH) bits
        sin_val : out signed(FRAC_BITS downto 0);        -- 11 bits: 1 sign + 10 frac
        cos_val : out signed(FRAC_BITS downto 0)
    );
end entity;

architecture behav of sincos_lut is

    constant DATA_WIDTH : integer := FRAC_BITS + 1;      -- 11 bits
    constant COS_OFFSET : integer := LUT_DEPTH / 4;      -- 256 entries = 90deg

    type rom_t is array(0 to LUT_DEPTH - 1) of
        std_logic_vector(DATA_WIDTH - 1 downto 0);

    signal rom : rom_t;
    attribute ram_init_file : string;
    attribute ram_init_file of rom : signal is "sin_lut.mif";

    signal sin_idx : integer range 0 to LUT_DEPTH - 1;
    signal cos_idx : integer range 0 to LUT_DEPTH - 1;
    signal sin_raw : std_logic_vector(DATA_WIDTH - 1 downto 0);
    signal cos_raw : std_logic_vector(DATA_WIDTH - 1 downto 0);

begin

    -- cos(angle) = sin(angle + 90deg)
    sin_idx <= to_integer(angle);
    cos_idx <= (to_integer(angle) + COS_OFFSET) mod LUT_DEPTH;

    -- Registered ROM read — 1 cycle latency
    process(clk)
    begin
        if rising_edge(clk) then
            sin_raw <= rom(sin_idx);
            cos_raw <= rom(cos_idx);
        end if;
    end process;

    -- Reinterpret raw bits as signed two's complement (free in hardware)
    sin_val <= signed(sin_raw);
    cos_val <= signed(cos_raw);

end architecture;
